TATUM_API_KEY=
TATUM_SUI_NETWORK=testnet
TATUM_SUI_ENDPOINT=
LINOW_PACKAGE_ID=0x8460a046d70e0e0940d556d9526c48ee683ca8672390ff6480e937dc9a69d6aa
# Use NEXT_PUBLIC_LINOW_PACKAGE_ID instead of LINOW_PACKAGE_ID only when the browser app needs to display or build transactions with the public package ID.
NEXT_PUBLIC_LINOW_PACKAGE_ID=0x8460a046d70e0e0940d556d9526c48ee683ca8672390ff6480e937dc9a69d6aa
WALRUS_NETWORK=testnet
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Agent provider. Use gemini for demo evidence analysis; groq remains available as fallback.
AGENT_PROVIDER=gemini

GROQ_API_KEY=
# Optional pooled Groq keys for rate-limit failover. Separate with commas or new lines.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
# Optional local TPM pacing controls. Defaults are tuned for Groq on-demand 8K TPM.
GROQ_TPM_LIMIT=8000
GROQ_TPM_WINDOW_MS=60000
GROQ_TPM_SAFETY_BUFFER=200
GROQ_TPM_CHARS_PER_TOKEN=3.2
GROQ_TPM_COMPLETION_RESERVE=220

GEMINI_API_KEY=
# Optional pooled Gemini keys for failover only. Gemini API limits are applied per project, not per key.
GEMINI_API_KEYS=
# GOOGLE_API_KEY is also accepted as a fallback if GEMINI_API_KEY is empty.
GEMINI_MODEL=gemini-3.5-flash
# auto = attach PDFs only when local text extraction is weak, always = use Gemini native PDF for every PDF, off = text only.
GEMINI_PDF_MODE=auto
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MAX_INLINE_ATTACHMENT_BYTES=20971520
GEMINI_TPM_LIMIT=1000000
GEMINI_TPM_WINDOW_MS=60000
GEMINI_TPM_SAFETY_BUFFER=2000
GEMINI_TPM_CHARS_PER_TOKEN=3.5
GEMINI_TPM_COMPLETION_RESERVE=1200

# MemWal server-side credentials. Never expose these as NEXT_PUBLIC_* values.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memwal.ai
# Optional 32-byte key for encrypted Walrus agent-memory fallback.
# Use 64-char hex or base64-encoded raw key bytes.
LINOW_AGENT_MEMORY_ENCRYPTION_KEY=

# Web PoC persistence for synthetic demo files and cross-browser reviewer flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
